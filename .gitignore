# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── 构建产物 ────────────────────────────────────────────
# dist/ 里是 .deb / tar.gz / docker tar，体积以百 MB 计。
# 这些走 GitHub Releases 发布，不进版本库 —— 否则 clone 一次要下 250MB+，
# 而且每次重新构建都会产生巨大的二进制 diff。
# 需要留档的只有源码和构建脚本。
dist/*
!dist/.gitkeep

# 离线依赖暂存区（make-offline-deps.sh 的输出）
offline-deps/
*.deb
# 但打包用的元数据要留
!packaging/deb/**

# ── 构建中间态 ──────────────────────────────────────────
# .solveroot 是依赖求解用的空 apt 根（见 make-offline-deps.sh 注释），
# .closure / .allpkgs 是包名中间列表，都不该进库。
.solveroot/
.closure
.allpkgs
.sim.txt
.sim.err
.aptlists/
.offline-stage/
.snapshots/
*.tmp

# ── 测试与验收的运行时残留 ──────────────────────────────
_dev/.tmp/
_dev/live-*.log
# 跑测试时的输出重定向。_out_audit.txt 早先被误提交进版本库，
# 已从索引移除并在此忽略 —— 它是每次跑测试都会变的中间产物。
_dev/_out*.txt
# run-static.py 的逐项进度日志（崩了之后靠它定位跑到哪）
_dev/.run-static.log
*.log
!docs/**/*.log

# ── 编辑器 / 系统 ───────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# 截图画廊的本地预览页（一次性产物，别进库）
_preview-shots.html
_preview-*.html

# ── 凭据（绝不能进库）──────────────────────────────────
*.pem
*.key
!docs/**/*.key
id_rsa*
.credentials
.env
.env.*

# jsstrip 自检的中间产物（剥完的 app.js，只给 node 侧交叉验证用）
_dev/.jsstrip-*.out
