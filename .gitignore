# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── 构建产物 ────────────────────────────────────────────
# dist/ 里是 .deb / tar.gz / docker tar，体积以百 MB 计。
# 这些走 GitHub Releases 发布，不进版本库 —— 否则 clone 一次要下 250MB+，
# 而且每次重新构建都会产生巨大的二进制 diff。
# 需要留档的只有源码和构建脚本。
dist/*
!dist/.gitkeep

# 离线依赖暂存区（make-offline-deps.sh 的输出）
offline-deps/
*.deb
# 但打包用的元数据要留
!packaging/deb/**

# ── 构建中间态 ──────────────────────────────────────────
# .solveroot 是依赖求解用的空 apt 根（见 make-offline-deps.sh 注释），
# .closure / .allpkgs 是包名中间列表，都不该进库。
.solveroot/
.closure
.allpkgs
.sim.txt
.sim.err
.aptlists/
.offline-stage/
.snapshots/
*.tmp

# ── 测试与验收的运行时残留 ──────────────────────────────
_dev/.tmp/
_dev/live-*.log
# 跑测试时的输出重定向。_out_audit.txt 早先被误提交进版本库，
# 已从索引移除并在此忽略 —— 它是每次跑测试都会变的中间产物。
_dev/_out*.txt
# run-static.py 的逐项进度日志（崩了之后靠它定位跑到哪）
_dev/.run-static.log
*.log
!docs/**/*.log

# ── 编辑器 / 系统 ───────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# 截图画廊的本地预览页（一次性产物，别进库）
_preview-shots.html
_preview-*.html

# ── 凭据（绝不能进库）──────────────────────────────────
*.pem
*.key
!docs/**/*.key
id_rsa*
.credentials
.env
.env.*

# jsstrip 自检的中间产物（剥完的 app.js，只给 node 侧交叉验证用）
_dev/.jsstrip-*.out

# ── i18n / 排版 排查时的一次性脚本与真机抓取样本（2026-10-09/10）──
# 根目录下划线的都是排查中间态，不是产品代码，也不是可复用的检查器。
/_*.py
/_*.js
/_*.json
/_*.raw
/_*.txt
/_page_notes.json
/_extract_i18n.json

# _dev/ 里「. 开头」的运行残留（探针、审计产物、JSON 快照）
_dev/.*
# 一次性修复脚本（fix-* / wire-* / wrap-* / i18n-en* / merge-en* / gen-opt-* 等）
_dev/_fix-*.py
_dev/_fu*.py
_dev/_mk-*.py
_dev/_dbg*.py
_dev/_dbg*.js
_dev/_chk_*.py
_dev/_scan*.py
_dev/_rev*.py
_dev/_syntaxfix.py
_dev/_integrity.py
_dev/_patch*.py
_dev/_expose*.py
_dev/_unify*.py
_dev/_restore*.py
_dev/_opt-*.py
_dev/_opt-*.js
_dev/_opt-*.json
_dev/_opt-*.txt
_dev/_addmulti.py
_dev/_backend-tables.json
_dev/_bt-check.js
_dev/_tables.txt
_dev/_tk*.json
_dev/_tmp_cover.py
_dev/_wire-*.py
_dev/_restorebt2.py
_dev/fix-*.py
_dev/apply-*.py
_dev/merge-en*.py
_dev/i18n-en*.py
_dev/gen-opt-*.py
_dev/i18n-scan.py
_dev/i18n-progress.py
_dev/i18n-where.py
_dev/i18n-todo.txt
_dev/missing-keys.py
_dev/msg-en*.py
_dev/scan-*.py
_dev/scan-*.js
_dev/wrap-*.py
_dev/wire-bt2.py
_dev/upd-inject.py
_dev/i18nbatch/
# 截图与审计运行产物
_dev/shots-*/
_dev/sync-deploy-*.txt
_dev/verify-deploy-*.txt
_dev/*.png
_dev/.layout/
# 真机审计的 JSON 产物（跑一次生成一批）
_dev/.live-aud-*.json
_dev/.live-*.txt
_dev/.ocr-*.tsv
_dev/.ocr-*.log
_dev/.static-out*.txt
_dev/.sync-out.txt
_dev/.try-*.json
_dev/.text-wide-*.txt
# 反向验证备份
_dev/*.rvbak
_dev/*.bak
# 一次性修复脚本（_fixseg 等无语义文件名）
_dev/_fixseg.py
_dev/_fix_check_views.py
_dev/_fix_docker_note.py
_dev/tpl-todo.txt
_dev/probe-*.sh
_dev/probe-*.js
_dev/probe2.sh
